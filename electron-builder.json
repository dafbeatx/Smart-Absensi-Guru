{
  "appId": "com.smartabsensi.guru.desktop",
  "productName": "Smart Absensi Guru",
  "copyright": "Copyright © 2026 SMP Terpadu Al-Ittihadiyah & SMA Terpadu As Salaam",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "build/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "publisherName": "SMP Terpadu Al-Ittihadiyah",
    "requestedExecutionLevel": "asInvoker",
    "legalTrademarks": "Smart Absensi Guru"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Smart Absensi Guru",
    "artifactName": "Smart-Absensi-Guru-Setup-${version}.${ext}",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico"
  },
  "portable": {
    "artifactName": "Smart-Absensi-Guru-Portable-${version}.${ext}"
  }
}
