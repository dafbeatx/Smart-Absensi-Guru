# SMART ABSENSI GURU - ENVIRONMENT CONFIGURATION EXAMPLE

# Data Provider Switcher (mock | gas | supabase)
VITE_PROVIDER="supabase"

# Supabase PostgreSQL Configuration
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Google Apps Script Web App Deployment URL (Fallback)
VITE_API_URL="https://script.google.com/macros/s/YOUR_GOOGLE_APPS_SCRIPT_WEBAPP_ID/exec"

# Application Environment (development | production)
VITE_APP_ENV="development"

# Enterprise Feature Flags System
VITE_FEATURE_WHATSAPP=true
VITE_FEATURE_AUDIT=true
VITE_FEATURE_ANALYTICS=true
VITE_FEATURE_PWA=true
VITE_FEATURE_OFFLINE_SYNC=true
VITE_FEATURE_EXCEL_EXPORT=true
VITE_FEATURE_AI_ASSISTANT=true

# Groq AI Assistant Engine Configuration
VITE_GROQ_API_KEY="YOUR_GROQ_API_KEY"
VITE_GROQ_MODEL="llama-3.3-70b-versatile"

# Cloudflare Turnstile Security Configuration
VITE_TURNSTILE_SITE_KEY="YOUR_TURNSTILE_SITE_KEY"
TURNSTILE_SECRET_KEY="YOUR_TURNSTILE_SECRET_KEY"

