# SMART ABSENSI GURU - ENVIRONMENT CONFIGURATION EXAMPLE

# Data Provider Switcher (mock | gas)
VITE_PROVIDER="mock"

# Google Apps Script Web App Deployment URL
VITE_API_URL="https://script.google.com/macros/s/YOUR_GOOGLE_APPS_SCRIPT_WEBAPP_ID/exec"

# Application Environment (development | production)
VITE_APP_ENV="development"

# Enterprise Feature Flags System
VITE_FEATURE_WHATSAPP=true
VITE_FEATURE_AUDIT=true
VITE_FEATURE_ANALYTICS=true
VITE_FEATURE_PWA=true
VITE_FEATURE_OFFLINE_SYNC=true
VITE_FEATURE_EXCEL_EXPORT=true
